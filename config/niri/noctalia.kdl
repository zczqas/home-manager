layout {

    focus-ring {
        active-color   "#a9cdcf"
        inactive-color "#121414"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#a9cdcf"
        inactive-color "#121414"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#a9cdcf"
        inactive-color "#355759"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#a9cdcf80"
    }
}

recent-windows {
    highlight {
        active-color "#a9cdcf"
        urgent-color "#ffb4ab"
    }
}
