# ╔════════════════════════════════════════════════════════════════════════════╗
# ║ Appearance                                                                 ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# theme                            = Catppuccin Latte
theme                            = Catppuccin Mocha
# background-opacity                 = 0.95
# background-blur                    = true

# custom-shader                      = ~/.config/ghostty/shaders/cursor-warp.glsl
# custom-shader                     = ~/.config/ghostty/bettercrt.glsl
#custom-shader                     = ~/.config/ghostty/tft.glsl
#custom-shader                     = ~/.config/ghostty/bloom.glsl
#custom-shader                     = ~/.config/ghostty/glitchy.glsl


# ╔════════════════════════════════════════════════════════════════════════════╗
# ║ Font                                                                       ║
# ╚════════════════════════════════════════════════════════════════════════════╝

font-size                          = 11
#font-family                       = "Berkeley Mono"
font-family                       = JetBrainsMono Nerd Font
font-style-bold                    = false
font-style-italic                  = false
font-style-bold-italic             = false
bold-is-bright                     = true
adjust-cell-height                 = 1


# ╔════════════════════════════════════════════════════════════════════════════╗
# ║ Window                                                                     ║
# ╚════════════════════════════════════════════════════════════════════════════╝

window-padding-x                   = 6
#window-padding-y                   = 12
window-padding-y                   = 6
window-padding-balance             = true
window-padding-color               = background
window-vsync                       = true
window-decoration                  = none
window-theme                       = ghostty
window-width                       = 8000
window-height                      = 2000

resize-overlay                     = never


# ╔════════════════════════════════════════════════════════════════════════════╗
# ║ Features                                                                   ║
# ╚════════════════════════════════════════════════════════════════════════════╝

scrollback-limit                   = 125000
link-url                           = true
vt-kam-allowed                     = false


# ╔════════════════════════════════════════════════════════════════════════════╗
# ║ Cursor                                                                     ║
# ╚════════════════════════════════════════════════════════════════════════════╝

cursor-opacity                     = 0.9
cursor-style                       = block
cursor-style-blink                 = false
cursor-click-to-move               = false
shell-integration-features         = no-cursor
shell-integration                  = fish




# ╔════════════════════════════════════════════════════════════════════════════╗
# ║ Clipboard                                                                  ║
# ╚════════════════════════════════════════════════════════════════════════════╝

clipboard-trim-trailing-spaces     = true
clipboard-paste-bracketed-safe     = true
copy-on-select                     = false
confirm-close-surface              = false


# ╔════════════════════════════════════════════════════════════════════════════╗
# ║ GTK                                                                        ║
# ╚════════════════════════════════════════════════════════════════════════════╝

gtk-single-instance                = true
gtk-tabs-location                  = bottom
#gtk-adwaita                       = false
gtk-opengl-debug                   = false
gtk-titlebar                       = false


# ╔════════════════════════════════════════════════════════════════════════════╗
# ║ Update                                                                     ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# auto-update                        = off

