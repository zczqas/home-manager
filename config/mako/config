anchor=top-right
text-alignment=left
width=400
max-history=10
sort=-time

on-button-left=invoke-default-action
on-button-middle=exec makoctl menu -n $id bemenu -p 'Select action: '
on-button-right=dismiss

max-visible=10
font=JetBrainsMono Nerd Font 9
max-icon-size=38
icon-location=left
margin=6
padding=12
format=<b>%s</b>\n\n%b

background-color=#1e1e2e
text-color=#cdd6f4
border-size=2
border-radius=0
border-color=#f38ba8
progress-color=over #313244
default-timeout=10000

[urgency=low]
text-color=#7f849c
border-color=#45475a
default-timeout=10000

[urgency=normal]
text-color=#cdd6f4
border-color=#f38ba8
default-timeout=10000

[urgency=critical]
text-color=#f5e0dc
border-color=#f38ba8
default-timeout=0

[urgency=high]
text-color=#cdd6f4
border-color=#eba0ac
default-timeout=10000
